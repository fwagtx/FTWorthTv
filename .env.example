# ---------- Where posts go ----------
# dryrun  = render images + captions into ./out for review (no network posting)
# facebook = post directly to your Page via the Graph API
# metricool = schedule through Metricool (needs the API add-on on your Metricool plan)
FTWTV_PUBLISHER=dryrun

# ---------- Facebook Page (publisher=facebook) ----------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v25.0
# Optional: Facebook Place ID to tag posts with a location (e.g. Fort Worth, Texas)
FB_PLACE_ID=
# Only needed for `ftworthtv fb-token` (exchanging a short-lived user token for a permanent page token)
FB_APP_ID=
FB_APP_SECRET=

# ---------- Metricool (publisher=metricool) ----------
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# comma separated: facebook,instagram
METRICOOL_NETWORKS=facebook
# Metricool needs PUBLIC image URLs. If this repo is public, the workflow can commit images and serve them from raw.githubusercontent.com:
#   https://raw.githubusercontent.com/<owner>/<repo>/<branch>
MEDIA_BASE_URL=

# ---------- Caption writer (Claude) ----------
# Leave empty to use the built-in template writer (no AI cost). With a key, Claude writes the captions.
ANTHROPIC_API_KEY=
FTWTV_MODEL=claude-opus-5-5
FTWTV_EFFORT=medium

# ---------- Photos ----------
# Pexels: free API, free commercial license, real photos of Fort Worth. https://www.pexels.com/api/
PEXELS_API_KEY=
# Ticketmaster Discovery API: free key, real event images + ticket links for Dickies Arena etc. https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# National Weather Service requires an identifying User-Agent (any app name + contact)
NWS_USER_AGENT=FTWorthTv/0.1 (contact: you@example.com)

# ---------- Behaviour ----------
FTWTV_MAX_POSTS=2
FTWTV_SINCE_HOURS=36
FTWTV_OUT_DIR=out
FTWTV_STATE_PATH=state/posted.json
