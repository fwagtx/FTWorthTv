# ---------- Where posts go ----------
# dryrun  = render images + captions into ./out for review (no network posting)
# facebook = post directly to your Page via the Graph API
# metricool = schedule through Metricool (needs the API add-on on your Metricool plan)
FTWTV_PUBLISHER=dryrun

# ---------- Facebook Page (publisher=facebook) ----------
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_VERSION=v25.0
# Optional: Facebook Place ID to tag posts with a location (e.g. Fort Worth, Texas)
FB_PLACE_ID=
# Only needed for `ftworthtv fb-token` (exchanging a short-lived user token for a permanent page token)
FB_APP_ID=
FB_APP_SECRET=
# Free Instagram cross-posting: the Instagram Business account id linked to the Page (token needs instagram_basic + instagram_content_publish)
# and MEDIA_BASE_URL below so the image has a public URL.
IG_USER_ID=

# ---------- Metricool (publisher=metricool) ----------
METRICOOL_USER_TOKEN=
METRICOOL_USER_ID=
METRICOOL_BLOG_ID=
# comma separated: facebook,instagram (threads, tiktok need a video/image too; see Metricool's rules)
METRICOOL_NETWORKS=facebook,instagram
# true = publish automatically at the scheduled time; false = Metricool sends it to your phone for one-tap approval
METRICOOL_AUTOPUBLISH=true
# Metricool needs PUBLIC image URLs. If this repo is public, the workflow can commit images and serve them from raw.githubusercontent.com:
#   https://raw.githubusercontent.com/<owner>/<repo>/<branch>
MEDIA_BASE_URL=

# ---------- Caption writer ----------
# auto (default) = Claude Code with your subscription token if present, else the Anthropic API if a key is present, else the template.
# template = never call any AI (free, deterministic)
FTWTV_WRITER=auto
# Free with a Claude Pro/Max subscription: run `claude setup-token` on your computer and paste the token here / in GitHub secrets.
CLAUDE_CODE_OAUTH_TOKEN=
# Pay-as-you-go alternative (NOT needed if you use the subscription token above)
ANTHROPIC_API_KEY=
FTWTV_MODEL=claude-opus-5-5
FTWTV_EFFORT=medium

# ---------- Photos (any one key is enough; openverse + wikimedia work with no key at all) ----------
# Unsplash: free access key at unsplash.com/developers (50 requests/hour on the demo tier, plenty)
UNSPLASH_ACCESS_KEY=
# Flickr: free key at flickr.com/services/apps/create — Creative Commons photos; the deepest Fort Worth coverage
FLICKR_API_KEY=
# Pixabay: free key at pixabay.com/api/docs
PIXABAY_API_KEY=
# Pexels: free commercial license (new key issuance was paused in Nov 2026; use it if you already have one)
PEXELS_API_KEY=
# Openverse: works anonymously; optional client credentials from api.openverse.org/v1/#tag/auth raise the rate limit
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
# Ticketmaster Discovery API: free key, real event images + ticket links for Dickies Arena etc. https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# National Weather Service requires an identifying User-Agent (any app name + contact)
NWS_USER_AGENT=FTWorthTv/0.1 (contact: you@example.com)

# ---------- Behaviour ----------
FTWTV_MAX_POSTS=2
FTWTV_SINCE_HOURS=36
FTWTV_OUT_DIR=out
FTWTV_STATE_PATH=state/posted.json
